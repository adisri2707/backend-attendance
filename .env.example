# Local MySQL connection
DB_URL=jdbc:mysql://localhost:3306/attendance_management_system?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-mysql-password

# Keep both false for local Postman testing.
APP_SECURITY_ENABLED=false
FIREBASE_ENABLED=false

# Required only when both Firebase and security are enabled.
# FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json
